yabai -m signal --add event=space_created action='yabai -m space $YABAI_SPACE --layout bsp'
~/.config/yabai/scripts/screen_sizes.sh apply
for e in display_added display_removed display_changed display_moved; do
  yabai -m signal --add event=$e action='~/.config/yabai/scripts/screen_sizes.sh apply'
done
~/.config/yabai/restore_spaces.sh &
