# Note: try setup karabiner to rebind caps to hyper, but for me doesn't work with hyper+shift somehow

# Move and focus windowos
ctrl + alt - h: yabai -m window --focus west
ctrl + alt - j: yabai -m window --focus south
ctrl + alt - k: yabai -m window --focus north
ctrl + alt - l: yabai -m window --focus east
ctrl + alt + shift - h: yabai -m window --warp west
ctrl + alt + shift - j: yabai -m window --warp south
ctrl + alt + shift - k: yabai -m window --warp north
ctrl + alt + shift - l: yabai -m window --warp east

# Resize windowos and layouts
ctrl + alt - up: yabai -m window --resize top:0:-20
ctrl + alt + shift - down: yabai -m window --resize top:0:20
ctrl + alt - down: yabai -m window --resize bottom:0:20
ctrl + alt + shift - up: yabai -m window --resize bottom:0:-20
ctrl + alt - left: yabai -m window --resize left:-20:0
ctrl + alt + shift - right: yabai -m window --resize left:20:0
ctrl + alt - right: yabai -m window --resize right:20:0
ctrl + alt + shift - left: yabai -m window --resize right:-20:0
ctrl + alt - z: yabai -m window --toggle zoom-fullscreen
ctrl + alt - space: yabai -m space --layout next
ctrl + alt - s: yabai -m space --layout stack
ctrl + alt - b: yabai -m space --layout bsp

# Manage windowos
ctrl + alt - f: yabai -m window --toggle float
ctrl + alt - r: yabai -m space --rotate 90
ctrl + alt - v: yabai -m window --toggle split
ctrl + alt - e: yabai -m space --balance
ctrl + alt - t: sh -c '~/.config/yabai/scripts/focus-or-open.sh kitty'
ctrl + alt - c: sh -c '~/.config/yabai/scripts/focus-or-open.sh Code'

# Jump to spaces
ctrl + alt - 1: yabai -m space --focus 1
ctrl + alt - 2: yabai -m space --focus 2
ctrl + alt - 3: yabai -m space --focus 3
ctrl + alt - 4: yabai -m space --focus 4
ctrl + alt - 5: yabai -m space --focus 5
ctrl + alt - 6: yabai -m space --focus 6
ctrl + alt - 7: yabai -m space --focus 7
ctrl + alt - 8: yabai -m space --focus 8
ctrl + alt - 9: yabai -m space --focus prev
ctrl + alt - 0: yabai -m space --focus next

# Move windowo to spaces
ctrl + alt + shift - 1: yabai -m window --space 1
ctrl + alt + shift - 2: yabai -m window --space 2
ctrl + alt + shift - 3: yabai -m window --space 3
ctrl + alt + shift - 4: yabai -m window --space 4
ctrl + alt + shift - 5: yabai -m window --space 5
ctrl + alt + shift - 6: yabai -m window --space 6
ctrl + alt + shift - 7: yabai -m window --space 7
ctrl + alt + shift - 8: yabai -m window --space 8
ctrl + alt + shift - 9: yabai -m window --space prev
ctrl + alt + shift - 0: yabai -m window --space next
