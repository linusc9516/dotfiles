{
  "$schema": "https://opencode.ai/config.json",
  "model": "wafer/DeepSeek-V4.1-Flash-1017",
  "small_model": "deepinfra/deepseek-ai/DeepSeek-V4-Flash-0731",
  "share": "disabled",
  "default_agent": "coding",
  "compaction": {
    "auto": true,
    "prune": true,
    "buffer": "20%"
  },
  "agents": {
    "general": { "disabled": true },
    "explore": { "disabled": true }
  },
  "plugins": [
    "envsitter-guard"
  ],
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "ask" },
    { "action": "edit", "resource": "*.env.*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "ls", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "fd *", "effect": "allow" },
    { "action": "shell", "resource": "git status", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "ask" }
  ],
  "provider": {
    "deepinfra": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepInfra",
      "options": {
        "baseURL": "https://api.deepinfra.com/v1/openai"
      },
      "models": {
        "deepseek-ai/DeepSeek-V4.1-Flash-1017": { "name": "DeepSeek V4.1 Flash 1017" },
        "deepseek-ai/DeepSeek-V4-Flash-0731": { "name": "DeepSeek V4 Flash 0731" },
        "zai-org/GLM-5.3-Flash": { "name": "GLM 5.3 Flash" },
        "openai/gpt-oss-120b": { "name": "gpt-oss 120B" },
        "XiaomiMiMo/MiMo-V2.6-Pro": { "name": "MiMo V2.6 Pro" },
        "Qwen/Qwen3-235B-A22B": { "name": "Qwen 3 MoE" },
        "mistralai/Mistral-Small-3.2-24B-Instruct-2506": { "name": "Mistral Small 3.2" },
        "meta-llama/Llama-3.3-70B-Instruct-Turbo": { "name": "Llama 3.3 70B Turbo" }
      }
    },
    "wafer": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Wafer",
      "options": {
        "baseURL": "https://pass.wafer.ai/v1",
        "apiKey": "{env:WAFER_API_KEY}",
        "reasoningEffort": "none"
      },
      "models": {
        "DeepSeek-V4.1-Flash-1017": {
          "name": "DeepSeek V4.1 Flash 1017",
          "limit": { "context": 1048576, "output": 65536 }
        },
        "DeepSeek-V4.1-Flash": { "name": "DeepSeek V4.1 Flash" },
        "DeepSeek-V4-Flash-0731-Fast": { "name": "DeepSeek V4 Flash 0731 Fast" },
        "GLM-5.3": { "name": "GLM 5.3" }
      }
    }
  },
  "mcp": {
    "servers": {
      "ddg-search": {
        "type": "local",
        "command": ["uvx", "duckduckgo-mcp-server"]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
      },
      "gworkspace": {
        "type": "local",
        "command": ["uvx", "workspace-mcp", "--permissions", "gmail:readonly", "calendar:full", "tasks:full"],
        "environment": {
          "GOOGLE_CLIENT_SECRET_PATH": "/Users/linusc/.config/workspace-mcp/client_secret.json",
          "GOOGLE_OAUTH_REDIRECT_URI": "http://localhost:8000/oauth2callback"
        },
        "codemode": false
      }
    }
  }
}
